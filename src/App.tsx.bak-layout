  | "twitter"
  | "facebook"
  | "linkedin"
  | "tiktok"
  | "youtube";

type Platform = {
  id: PlatformId;
  label: string;
  color: string;
  icon: string;
};

type PostStat = {
  id: number;
  platform: PlatformId;
  text: string;
  date: string;
  reach: number;
  image: string | null;
};

type UploadedImage = {
  name: string;
  url: string;
};

type SourceType = "file" | "url";
type ExtractMode = "chars" | "code";
type TabName = "extract" | "edit" | "stats";
type Language = "en" | "id";

