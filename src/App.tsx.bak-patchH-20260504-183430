  function getMediaVersion(postId: string, source: MediaSource, type: MediaType) {
    return (
      mediaAssets.filter(
        (asset) =>
          asset.postId === postId &&
          asset.source === source &&
          asset.type === type
      ).length + 1
    );
  }

  function normalizeExtension(fileName: string, mediaType: MediaType) {
    const ext = fileName.split(".").pop()?.toLowerCase();

    if (!ext) return mediaType === "image" ? "png" : "mp4";

    if (mediaType === "image") {
      if (["jpg", "jpeg", "png", "webp", "gif"].includes(ext)) return ext;
      return "png";
    }

    if (["mp4", "mov", "webm", "mkv"].includes(ext)) return ext;
    return "mp4";
  }

  function buildMediaFileName(
    postCode: string,
    source: MediaSource,
    mediaType: MediaType,
    version: number,
    extension: string
  ) {
    return `ap-${postCode}-${source}-${mediaType}-v${version}.${extension}`;
  }

