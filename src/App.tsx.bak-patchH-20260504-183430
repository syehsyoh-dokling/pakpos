}

type ButtonProps = {
  children: ReactNode;
  onClick?: () => void;
  variant?: "primary" | "secondary";
  disabled?: boolean;
  type?: "button" | "submit";
};

function Button({
  children,
  onClick,
  variant = "primary",
  disabled = false,
  type = "button",
}: ButtonProps) {
  return (
    <button
      type={type}
      disabled={disabled}
      onClick={onClick}
      className={`btn btn-${variant}`}
    >
      {children}
    </button>
  );
}

type TabButtonProps = {
  active: boolean;
  children: ReactNode;
  badge?: number;
  onClick: () => void;
  disabled?: boolean;
};

function TabButton({
  active,
  children,
  badge = 0,
  onClick,
  disabled = false,
}: TabButtonProps) {
  return (
    <button
      className={`tab-btn ${active ? "active" : ""} ${disabled ? "is-disabled" : ""}`}
      onClick={disabled ? undefined : onClick}
      disabled={disabled}
    >
      <span>{children}</span>
      {badge > 0 && <strong>{badge}</strong>}
    </button>
  );
}

type StatCardProps = {
  title: string;
  value: string | number;
  caption: string;
};

function StatCard({ title, value, caption }: StatCardProps) {
  return (
    <div className="stat-card glass">
      <span>{title}</span>
      <strong>{value}</strong>
      <small>{caption}</small>
    </div>
  );
}

