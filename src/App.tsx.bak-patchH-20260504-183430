  const hasChunks = chunks.length > 0;
  const approvedDrafts = drafts.filter((draft) => draft.status === "approved");
  const hasApprovedDrafts = approvedDrafts.length > 0;
  const hasPublishedPosts = stats.length > 0;

  const estimatedChunks = useMemo(() => {
    if (!rawText.trim()) return 0;

    if (splitMethod === "paragraphs") {
      return extractByParagraphs(rawText, maxChars).length;
    }

    if (splitMethod === "markers") {
      return extractByMarkers(rawText, startCode, endCode).length;
    }

    return extractByChars(rawText, maxChars).length;
  }, [rawText, splitMethod, maxChars, startCode, endCode]);

  const totalReach = useMemo(() => {
    return stats.reduce((total, item) => total + item.reach, 0);
  }, [stats]);

  const activePlatforms = useMemo(() => {
    return new Set(stats.map((item) => item.platform)).size;
  }, [stats]);

  function importContent(sourceTypeValue: SourceType, sourceName: string, text: string) {
    const cleanText = text.trim();

    setImportedContent({
      id: makeId("content"),
      sourceType: sourceTypeValue,
      sourceName,
      rawText: cleanText,
      charCount: cleanText.length,
      importedAt: new Date().toISOString(),
    });

    setChunks([]);
    setDrafts([]);
    setQueue([]);
    setMediaAssets([]);
    setMediaBusy({});
  }

  function handleUseDemo() {
    importContent("paste", lang === "en" ? "demo-content.txt" : "konten-demo.txt", demoText);
  }

  function handleFileUpload(event: ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    if (!file) return;

    const fileName = file.name;
    const lower = file.name.toLowerCase();

    if (lower.endsWith(".txt")) {
      const reader = new FileReader();

      reader.onload = () => {
        importContent("file", fileName, String(reader.result || ""));
      };

      reader.readAsText(file);
      return;
    }

    if (lower.endsWith(".pdf") || lower.endsWith(".docx") || lower.endsWith(".doc")) {
      importContent(
        "file",
        fileName,
        `${demoText}\n\n[Local preview note]\nPDF/DOCX parsing will be connected to backend in the next phase.`
      );
      return;
    }

    alert(
      lang === "en"
        ? "Supported files: TXT, PDF, DOC, DOCX."
        : "File yang didukung: TXT, PDF, DOC, DOCX."
    );
  }

  function handleUrlImport() {
    if (!url.trim()) return;

    importContent(
      "url",
      url.trim(),
      `${lang === "en" ? "Content from URL" : "Konten dari URL"}: ${url.trim()}\n\n${demoText}`
    );
  }

  function handlePasteImport() {
    if (!pasteText.trim()) return;
    importContent("paste", "manual-paste", pasteText);
  }

  function proceedToSplit() {
    if (!hasImportedContent) {
      alert(t.importFirstAlert);
      return;
    }

    setStep("split");
  }

  function generateChunksAndContinue() {
    if (!hasImportedContent) {
      alert(t.importFirstAlert);
      return;
    }

    let result: string[] = [];

    if (splitMethod === "paragraphs") {
      result = extractByParagraphs(rawText, maxChars);
    } else if (splitMethod === "markers") {
      result = extractByMarkers(rawText, startCode, endCode);
    } else {
      result = extractByChars(rawText, maxChars);
    }

    if (result.length === 0) {
      result = [rawText.slice(0, 5000)];
    }

    const nextChunks: ContentChunk[] = result.map((text, index) => ({
      id: makeId(`chunk_${index + 1}`),
      index: index + 1,
      text,
      charCount: text.length,
    }));

    const nextDrafts: DraftPost[] = nextChunks.map((chunk) => ({
      id: makeId(`draft_${chunk.index}`),
      chunkId: chunk.id,
      caption: chunk.text,
      platforms: [],
      status: "draft",
    }));

    setChunks(nextChunks);
    setDrafts(nextDrafts);
    setStep("review");
  }

  function updateDraftCaption(draftId: string, caption: string) {
    setDrafts((prev) =>
      prev.map((draft) =>
        draft.id === draftId
          ? {
              ...draft,
              caption,
              status: draft.status === "approved" ? "reviewed" : draft.status,
            }
          : draft
      )
    );
  }

  function togglePlatform(draftId: string, platformId: PlatformId) {
    setDrafts((prev) =>
      prev.map((draft) => {
        if (draft.id !== draftId) return draft;

        const nextPlatforms = draft.platforms.includes(platformId)
          ? draft.platforms.filter((item) => item !== platformId)
          : [...draft.platforms, platformId];

        return {
          ...draft,
          platforms: nextPlatforms,
          status: draft.status === "approved" ? "reviewed" : draft.status,
        };
      })
    );
  }

  function handleImageUpload(draftId: string, event: ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    if (!file) return;

    const ext = file.name.split(".").pop()?.toLowerCase();

    if (!ext || !["jpg", "jpeg", "png", "webp"].includes(ext)) {
      alert("Supported image formats: JPG, JPEG, PNG, WEBP.");
      return;
    }

    const uploadedImage: UploadedImage = {
      name: `post_${draftId.slice(-5)}.${ext}`,
      url: URL.createObjectURL(file),
    };

    setDrafts((prev) =>
      prev.map((draft) =>
        draft.id === draftId
          ? {
              ...draft,
              image: uploadedImage,
              status: draft.status === "approved" ? "reviewed" : draft.status,
            }
          : draft
      )
    );
  }

  function generateVisualPrompt(draftId: string) {
    const draft = drafts.find((item) => item.id === draftId);
    if (!draft) return;

    const prompt =
      lang === "en"
        ? `Modern social media visual, pastel earth-tone palette, editorial composition, clean layout, warm natural lighting, suitable for Auto POST. Main idea: ${draft.caption.slice(0, 220)}`
        : `Visual media sosial modern, palet pastel-earth, komposisi editorial, layout bersih, pencahayaan hangat natural, cocok untuk Auto POST. Ide utama: ${draft.caption.slice(0, 220)}`;

    setDrafts((prev) =>
      prev.map((item) =>
        item.id === draftId
          ? {
              ...item,
              visualPrompt: prompt,
            }
          : item
      )
    );
  }

  function approveDraft(draftId: string) {
    const draft = drafts.find((item) => item.id === draftId);
    if (!draft) return;

    if (!draft.caption.trim()) return;
    if (draft.platforms.length === 0) {
      alert(t.platformAlert);
      return;
    }

    setDrafts((prev) =>
      prev.map((item) =>
        item.id === draftId
          ? {
              ...item,
              status: "approved",
            }
          : item
      )
    );
  }

  function continueToSchedule() {
    if (!hasApprovedDrafts) {
      alert(t.approveFirstAlert);
      return;
    }

    const existingDraftIds = new Set(queue.map((item) => item.draftId));

    const newQueueItems: QueueItem[] = approvedDrafts
      .filter((draft) => !existingDraftIds.has(draft.id))
      .map((draft) => ({
        id: makeId("queue"),
        draftId: draft.id,
        caption: draft.caption,
        platforms: draft.platforms,
        image: draft.image,
        publishMode: "scheduled",
        status: "ready",
      }));

    if (newQueueItems.length > 0) {
      setQueue((prev) => [...prev, ...newQueueItems]);
    }

    setStep("schedule");
  }

  function updateSchedule(queueId: string, scheduledAt: string) {
    setQueue((prev) =>
      prev.map((item) =>
        item.id === queueId
          ? {
              ...item,
              scheduledAt,
              publishMode: "scheduled",
              status: scheduledAt ? "scheduled" : "ready",
            }
          : item
      )
    );
  }

  async function publishQueueItem(queueId: string) {
    const item = queue.find((queueItem) => queueItem.id === queueId);
    if (!item) return;

    setQueue((prev) =>
      prev.map((queueItem) =>
        queueItem.id === queueId
          ? {
              ...queueItem,
              publishMode: "now",
              status: "publishing",
            }
          : queueItem
      )
    );

    await new Promise((resolve) => setTimeout(resolve, 900));

    const now = new Date();
    const date = [
      now.getFullYear(),
      String(now.getMonth() + 1).padStart(2, "0"),
      String(now.getDate()).padStart(2, "0"),
    ].join("-");

    const time = [
      String(now.getHours()).padStart(2, "0"),
      String(now.getMinutes()).padStart(2, "0"),
    ].join(":");

    const newStats: PostStat[] = item.platforms.map((platform) => ({
      id: Date.now() + Math.random(),
      platform,
      text: `${item.caption.slice(0, 90)}...`,
      date: `${date} ${time}`,
      reach: Math.floor(Math.random() * 9000 + 1500),
      image: item.image?.name || null,
    }));

    setStats((prev) => [...newStats, ...prev]);

    setQueue((prev) =>
      prev.map((queueItem) =>
        queueItem.id === queueId
          ? {
              ...queueItem,
              status: "published",
              reach: newStats.reduce((total, stat) => total + stat.reach, 0),
            }
          : queueItem
      )
    );
  }

