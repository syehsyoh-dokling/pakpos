  }

  async function createMediaByPlaceholder(draftId: string, mediaType: MediaType) {
    const draft = drafts.find((item) => item.id === draftId);
    if (!draft) return;

    const postCode = getDraftPostCode(draftId);
    const busyKey = `${draftId}_${mediaType}_ai`;

    const payload: MediaCreatePayload = {
      postId: draft.id,
      postCode,
      mediaType,
      caption: draft.caption,
      visualPrompt: draft.visualPrompt,
      platforms: draft.platforms,
      endpointUrl: mediaEndpoint,
    };

    console.log("Prepared media create payload for backend:", payload);

    setMediaBusy((prev) => ({
      ...prev,
      [busyKey]: true,
    }));

    await new Promise((resolve) => setTimeout(resolve, 800));

    const version = getMediaVersion(draft.id, "ai", mediaType);
    const extension = mediaType === "image" ? "svg" : "mp4";
    const storedName = buildMediaFileName(postCode, "ai", mediaType, version, extension);

    const asset: MediaAsset = {
      id: makeId("media"),
      postId: draft.id,
      postCode,
      type: mediaType,
      source: "ai",
      originalName: storedName,
      storedName,
      url: mediaType === "image" ? createMediaSvgDataUrl(postCode, mediaType) : "",
      mimeType: mediaType === "image" ? "image/svg+xml" : "video/mp4",
      version,
      status: "ready",
      createdAt: new Date().toISOString(),
    };

    setMediaAssets((prev) => [asset, ...prev]);

    setMediaBusy((prev) => ({
      ...prev,
      [busyKey]: false,
    }));
  }

  function importMediaForDraft(
    draftId: string,
    mediaType: MediaType,
    event: ChangeEvent<HTMLInputElement>
  ) {
    const file = event.target.files?.[0];
    if (!file) return;

    const isImage = mediaType === "image";
    const isVideo = mediaType === "video";

    if (isImage && !file.type.startsWith("image/")) {
      alert(lang === "en" ? "Please choose an image file." : "Silakan pilih file gambar.");
      return;
    }

    if (isVideo && !file.type.startsWith("video/")) {
      alert(lang === "en" ? "Please choose a video file." : "Silakan pilih file video.");
      return;
    }

    const postCode = getDraftPostCode(draftId);
    const version = getMediaVersion(draftId, "user", mediaType);
    const extension = normalizeExtension(file.name, mediaType);
    const storedName = buildMediaFileName(postCode, "user", mediaType, version, extension);

    const asset: MediaAsset = {
      id: makeId("media"),
      postId: draftId,
      postCode,
      type: mediaType,
      source: "user",
      originalName: file.name,
      storedName,
      url: URL.createObjectURL(file),
      mimeType: file.type,
      size: file.size,
      version,
      status: "ready",
      createdAt: new Date().toISOString(),
    };

    setMediaAssets((prev) => [asset, ...prev]);

    console.log("Prepared imported media for backend upload:", {
      postId: draftId,
      postCode,
      mediaType,
      originalName: file.name,
      storedName,
      mimeType: file.type,
      size: file.size,
      endpointUrl: "/api/media/import",
    });

    event.target.value = "";
  }
