.tab-btn.is-disabled {
  opacity: 0.42 !important;
  cursor: not-allowed !important;
  filter: grayscale(0.3);
}

.section-desc {
  max-width: 760px;
  margin: 14px 0 0;
  color: #5f6d6f;
  line-height: 1.8;
  font-size: 15px;
}

.split-mode-row {
  flex-wrap: wrap;
  border-radius: 24px !important;
}

.split-mode-row button {
  flex: 1 1 180px;
}

.mini-summary {
  margin-top: 22px;
  padding: 18px 20px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 247, 237, 0.72);
  border: 1px solid rgba(176, 137, 104, 0.16);
}

.mini-summary span {
  color: #c2410c;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mini-summary strong {
  font-size: 34px;
  color: #6b7b5d;
  letter-spacing: -0.05em;
}

.draft-badge {
  padding: 8px 12px;
  color: #8f6c6c;
  background: rgba(221, 190, 169, 0.28);
  border: 1px solid rgba(176, 137, 104, 0.22);
  border-radius: 999px;
  font-size: 12px;
}

.upload-svg {
  width: 34px;
  height: 34px;
  display: block;
}

.upload-icon {
  color: #ffffff !important;
  font-size: 0 !important;
}

.form-group textarea {
  width: 100%;
  min-height: 220px;
  margin-top: 0;
}

.platform-pill {
  background: color-mix(in srgb, var(--platform-color) 42%, #b08968);
  border: 1px solid color-mix(in srgb, var(--platform-color) 32%, rgba(74, 87, 89, 0.12));
}

@media (max-width: 768px) {
  .mini-summary {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }
