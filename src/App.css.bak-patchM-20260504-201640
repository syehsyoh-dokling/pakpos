.settings-modal {
  width: min(620px, 100%);
  max-height: min(86vh, 760px);
  overflow: auto;
  padding: 28px;
  border-radius: 30px;
}

.settings-placeholder-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 18px;
}

.settings-placeholder-grid > div {
  padding: 16px;
  border-radius: 20px;
  background: rgba(255, 247, 237, 0.72);
  border: 1px solid rgba(176, 137, 104, 0.16);
}

.settings-placeholder-grid span {
  display: block;
  color: #c2410c;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.settings-placeholder-grid strong {
  display: block;
  margin-top: 6px;
  color: #4a5759;
  font-size: 17px;
}

.settings-placeholder-grid small {
  display: block;
  margin-top: 4px;
  color: #7a8574;
  font-size: 12px;
  line-height: 1.5;
}

/* Mobile header cleanup */
@media (max-width: 820px) {
  .landing-topbar {
    padding: 8px 0 !important;
  }

  .landing-topbar-inner {
    position: relative;
    display: grid !important;
    grid-template-columns: 1fr auto !important;
    align-items: center !important;
    gap: 12px !important;
  }

  .landing-brand {
    min-width: 0;
  }

  .landing-brand .brand-logo {
    width: 50px !important;
    height: 50px !important;
  }

  .landing-brand strong {
    font-size: 17px !important;
  }

  .landing-brand span {
    font-size: 12px !important;
  }

  .hamburger-btn {
    display: grid !important;
  }

  .landing-top-actions {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    z-index: 50;
    display: none !important;
    padding: 12px;
    border-radius: 22px;
    background: rgba(248, 245, 239, 0.96);
    border: 1px solid rgba(74, 87, 89, 0.08);
    box-shadow: 0 20px 46px rgba(74, 87, 89, 0.16);
    backdrop-filter: blur(16px);
  }

  .landing-top-actions.open {
    display: grid !important;
    gap: 10px !important;
  }

  .landing-top-actions .landing-lang,
  .landing-top-actions .landing-login-btn {
    width: 100% !important;
  }

  .landing-top-actions .landing-lang {
    justify-content: flex-start !important;
    overflow-x: auto !important;
  }

  .landing-top-actions .landing-login-btn {
    min-height: 46px !important;
  }
}

/* On desktop keep normal behavior */
@media (min-width: 821px) {
  .landing-top-actions {
    display: flex !important;
  }
}


/* ==========================================================
   PATCH L â€” IMPORT HISTORY + SPLIT CONFIG UX
   ========================================================== */

.import-clean-grid {
  grid-template-columns: 1fr !important;
}

.import-main-panel {
  padding: 28px !important;
}

.import-actions-head {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.history-btn {
  min-height: 44px;
  padding: 0 16px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 999px;
  cursor: pointer;
  color: #7c2d12;
  font-weight: 900;
  background: rgba(255, 247, 237, 0.92);
  border: 1px solid rgba(249, 115, 22, 0.20);
}

.history-btn b {
  min-width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #ffffff;
  background: #b08968;
  font-size: 11px;
}

.compact-upload-box {
  min-height: 210px !important;
}

.import-toolbar {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 18px;
}

.pending-badge {
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  padding: 0 14px;
  border-radius: 999px;
  color: #365314;
  background: rgba(190, 242, 100, 0.36);
  border: 1px solid rgba(132, 204, 22, 0.28);
  font-size: 12px;
  font-weight: 900;
}

/* History modal */
.history-modal {
  width: min(980px, 100%);
  max-height: min(86vh, 780px);
  overflow: auto;
  padding: 28px;
  border-radius: 30px;
}

.history-empty {
  margin-top: 18px;
  padding: 22px;
  border-radius: 22px;
  color: #7a8574;
  background: rgba(255, 247, 237, 0.72);
  border: 1px dashed rgba(176, 137, 104, 0.22);
}

.history-table-wrap {
  margin-top: 18px;
  overflow-x: auto;
}

.history-table td strong,
.history-table td small {
  display: block;
}

.history-table td small {
  margin-top: 4px;
  color: #7a8574;
  font-size: 12px;
}

.status-pill {
  min-height: 28px;
  display: inline-flex;
  align-items: center;
  margin: 3px 4px 3px 0;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 900;
  background: rgba(221, 190, 169, 0.28);
  color: #7c2d12;
}

.status-pill.split,
.status-pill.posted,
.status-pill.scheduled {
  color: #365314;
  background: rgba(190, 242, 100, 0.36);
}

.mini-action-btn {
  min-height: 36px;
  padding: 0 14px;
  border-radius: 999px;
  cursor: pointer;
  color: #ffffff;
  font-weight: 900;
  background: linear-gradient(135deg, #f59e0b, #fb7185 48%, #84cc16);
}

/* Split config modal */
.split-config-modal {
  width: min(720px, 100%);
  max-height: min(86vh, 760px);
  overflow: auto;
  padding: 28px;
  border-radius: 30px;
}

.split-config-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 18px;
}

.split-config-grid select {
  width: 100%;
  min-height: 46px;
  padding: 0 14px;
  color: #4a5759;
  border-radius: 14px;
  border: 1px solid rgba(74, 87, 89, 0.10);
  background: rgba(255, 255, 255, 0.78);
  outline: none;
}

.warning-box {
  margin-top: 16px;
  padding: 16px;
  border-radius: 18px;
  color: #7c2d12;
  background: rgba(254, 215, 170, 0.48);
  border: 1px solid rgba(249, 115, 22, 0.24);
  font-weight: 800;
  line-height: 1.55;
}

@media (max-width: 720px) {
  .import-actions-head {
    width: 100%;
    justify-content: flex-start;
  }

  .import-actions-head .switcher,
  .history-btn,
  .import-toolbar .btn {
    width: 100%;
  }

  .split-config-grid {
    grid-template-columns: 1fr;
  }

  .history-modal,
  .split-config-modal {
    padding: 20px;
    border-radius: 22px;
  }
}

