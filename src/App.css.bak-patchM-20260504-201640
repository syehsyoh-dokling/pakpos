.media-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.media-card {
  padding: 28px;
  border-radius: 30px;
}

.media-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.media-count {
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  padding: 0 14px;
  border-radius: 999px;
  color: #6b7b5d;
  background: rgba(204, 213, 174, 0.38);
  border: 1px solid rgba(163, 177, 138, 0.26);
  font-size: 12px;
  font-weight: 900;
}

.media-caption {
  margin: 16px 0 0;
  max-width: 980px;
  color: #4a5759;
  line-height: 1.75;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.media-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}

.media-list {
  display: grid;
  gap: 14px;
  margin-top: 22px;
}

.media-empty {
