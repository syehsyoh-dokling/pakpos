  width: 116px;
  height: 86px;
  overflow: hidden;
  border-radius: 16px;
  background: rgba(221, 190, 169, 0.22);
  display: grid;
  place-items: center;
}

.media-thumb img,
.media-thumb video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.media-video-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: linear-gradient(135deg, #b08968, #d4a5a5, #a3b18a);
  font-weight: 900;
  letter-spacing: 0.16em;
}

.media-info {
  min-width: 0;
  display: grid;
  gap: 5px;
}

.media-info strong {
  color: #4a5759;
  font-size: 14px;
  word-break: break-word;
}

.media-info span {
  color: #c2410c;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.media-info small {
  color: #7a8574;
  font-size: 12px;
  word-break: break-word;
}

@media (max-width: 640px) {
  .media-card {
    padding: 20px;
  }

  .media-card-head {
    flex-direction: column;
  }

  .media-asset {
    grid-template-columns: 1fr;
  }

  .media-thumb {
    width: 100%;
    height: 180px;
  }

  .media-actions .btn {
    width: 100%;
  }
}


