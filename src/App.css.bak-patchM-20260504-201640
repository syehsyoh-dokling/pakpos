}

@media (max-width: 1200px) {
  .topbar-inner,
  .container {
    width: min(100% - 28px, 1400px) !important;
  }

  .topbar-inner {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
  }

  .topbar-right {
    justify-content: flex-start !important;
    flex-wrap: wrap !important;
  }

  .page-grid {
    grid-template-columns: 1fr !important;
  }

  .intro-card {
    min-height: auto !important;
    padding: 32px !important;
  }

