.landing-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  padding: 14px 0;
  background: rgba(248, 245, 239, 0.88);
  border-bottom: 1px solid rgba(74, 87, 89, 0.08);
  backdrop-filter: blur(16px);
}

.landing-topbar-inner,
.landing-container,
.workspace-shell {
  width: min(1440px, calc(100% - 56px));
  margin: 0 auto;
}

.landing-topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.landing-brand .brand-logo {
  width: 62px !important;
  height: 62px !important;
}

.landing-top-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.landing-lang {
  min-height: 58px !important;
}

.landing-login-btn {
  min-height: 50px;
  padding: 0 20px;
  border-radius: 999px;
  cursor: pointer;
  color: #7c2d12;
  font-weight: 900;
  background: rgba(255, 247, 237, 0.92);
  border: 1px solid rgba(249, 115, 22, 0.20);
  box-shadow: 0 10px 24px rgba(180, 83, 9, 0.10);
}

.landing-login-btn.logout {
  color: #ffffff;
  background: linear-gradient(135deg, #b08968, #d4a5a5);
}

.landing-container {
  position: relative;
  z-index: 2;
  padding: 32px 0;
}

.landing-grid {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 28px;
  align-items: stretch;
}

.landing-copy-card,
.tutorial-card,
.auth-card {
  border-radius: 34px;
}

.landing-copy-card {
  padding: clamp(28px, 4vw, 56px);
  min-height: 520px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.landing-copy-card h1 {
  max-width: 880px !important;
  font-size: clamp(46px, 5vw, 82px) !important;
  line-height: 0.94 !important;
}

.landing-copy-card p:not(.eyebrow) {
  max-width: 820px;
  margin: 22px 0 0;
  color: #5f6d6f;
  line-height: 1.85;
  font-size: 16px;
}

.landing-benefits {
  display: grid;
  gap: 12px;
  margin-top: 28px;
}

.landing-benefit {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #4a5759;
}

.landing-benefit span {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 999px;
  color: #ffffff;
  font-weight: 900;
  background: linear-gradient(135deg, #f59e0b, #fb7185 48%, #84cc16);
}

.landing-benefit strong {
  font-size: 15px;
}

.landing-cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 32px;
}

.tutorial-card {
  padding: 26px;
  min-height: 520px;
}

.tutorial-frame {
  position: relative;
  height: 100%;
  min-height: 470px;
  overflow: hidden;
  border-radius: 28px;
  background:
    radial-gradient(circle at top left, rgba(212, 165, 165, 0.22), transparent 30%),
    linear-gradient(135deg, #f8f5ef, #ede6d8);
  border: 1px solid rgba(74, 87, 89, 0.08);
}

.tutorial-frame video {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.tutorial-placeholder {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: grid;
  place-content: center;
  gap: 10px;
  padding: 34px;
  text-align: center;
}

.tutorial-placeholder span {
  color: #c2410c;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.tutorial-placeholder strong {
  color: #4a5759;
  font-size: clamp(32px, 4vw, 56px);
  letter-spacing: -0.06em;
}

.tutorial-placeholder p {
  max-width: 460px;
  margin: 0 auto;
  color: #6b7b5d;
  line-height: 1.7;
}

.auth-section {
  padding-top: 4px;
}

.auth-card {
  padding: 34px;
  display: grid;
  grid-template-columns: 0.9fr 1fr 0.8fr;
  gap: 24px;
  align-items: center;
}

.auth-form {
  display: grid;
  gap: 14px;
}

.social-login-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.social-login-grid button {
  min-height: 48px;
  border-radius: 16px;
  cursor: pointer;
  color: #7c2d12;
  font-weight: 900;
  background: rgba(255, 247, 237, 0.86);
  border: 1px solid rgba(249, 115, 22, 0.18);
}

.workspace-section {
  position: relative;
  z-index: 2;
  padding: 14px 0 80px;
}

.workspace-shell {
  display: grid;
  grid-template-columns: 330px 1fr;
  gap: 24px;
  align-items: start;
}

.workspace-sidebar {
  position: sticky;
  top: 112px;
  padding: 22px;
  border-radius: 30px;
}

.workspace-user {
  padding: 18px;
  border-radius: 22px;
  background: rgba(255, 247, 237, 0.68);
  border: 1px solid rgba(176, 137, 104, 0.14);
}

.workspace-user span,
.workspace-user small {
  display: block;
  color: #7a8574;
  font-size: 12px;
}

.workspace-user strong {
  display: block;
  margin-top: 4px;
  color: #4a5759;
  font-size: 18px;
}

.workflow-menu {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.workflow-item {
  width: 100%;
  min-height: 78px;
  padding: 12px;
  display: grid;
  grid-template-columns: 42px 1fr auto;
  gap: 12px;
  align-items: center;
  text-align: left;
  cursor: pointer;
  border-radius: 22px;
  color: #4a5759;
  background: rgba(255, 255, 255, 0.54);
  border: 1px solid rgba(74, 87, 89, 0.08);
  transition: 0.2s ease;
}

.workflow-item:hover:not(:disabled),
.workflow-item.active {
  transform: translateY(-1px);
  background: rgba(255, 247, 237, 0.88);
  border-color: rgba(249, 115, 22, 0.22);
  box-shadow: 0 14px 28px rgba(180, 83, 9, 0.10);
}

.workflow-item.locked {
  cursor: not-allowed;
  opacity: 0.46;
}

.workflow-number {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  color: #ffffff;
  font-size: 12px;
  font-weight: 900;
  background: linear-gradient(135deg, #f59e0b, #fb7185 48%, #84cc16);
}

.workflow-text {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.workflow-text strong {
  color: #4a5759;
  font-size: 15px;
}

.workflow-text small {
  color: #7a8574;
  font-size: 12px;
  line-height: 1.45;
}

.workflow-item b {
  min-width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #ffffff;
  background: #b08968;
  font-size: 11px;
}

.workspace-content {
  min-width: 0;
}

.workspace-content > .page-grid {
  grid-template-columns: 1fr !important;
}

.workspace-content .intro-card {
  min-height: auto !important;
}

.workspace-content .landing-copy-card h1,
.workspace-content h1 {
  font-size: clamp(38px, 4vw, 64px) !important;
}

@media (max-width: 1180px) {
  .landing-topbar-inner,
  .landing-container,
  .workspace-shell {
    width: min(100% - 28px, 1440px);
  }

  .landing-grid,
  .auth-card,
  .workspace-shell {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar {
    position: relative;
    top: 0;
  }

  .workflow-menu {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 720px) {
  .landing-topbar-inner {
    align-items: flex-start;
    flex-direction: column;
  }

  .landing-top-actions,
  .landing-lang {
    width: 100%;
  }

  .landing-lang {
    overflow-x: auto;
  }

  .landing-copy-card,
  .tutorial-card,
  .auth-card,
  .workspace-sidebar {
    border-radius: 24px;
  }

  .landing-copy-card,
  .auth-card {
    padding: 24px;
  }

  .landing-copy-card h1 {
    font-size: clamp(38px, 12vw, 58px) !important;
  }

  .tutorial-card,
  .tutorial-frame {
    min-height: 360px;
  }

  .social-login-grid,
  .workflow-menu {
    grid-template-columns: 1fr;
  }

  .workflow-item {
    grid-template-columns: 42px 1fr auto;
  }
}


