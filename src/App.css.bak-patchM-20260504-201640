:root {
  color-scheme: light;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  background: #f5f1e8;
  color: #4a5759;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(212, 165, 165, 0.22), transparent 28%),
    radial-gradient(circle at top right, rgba(163, 177, 138, 0.20), transparent 30%),
    radial-gradient(circle at bottom center, rgba(221, 190, 169, 0.20), transparent 34%),
    linear-gradient(135deg, #f8f5ef 0%, #f2ede2 45%, #ede6d8 100%);
  color: #4a5759;
  overflow-x: hidden;
}

button,
input,
textarea {
  font: inherit;
}

button {
  border: 0;
}

.app-shell {
  position: relative;
  min-height: 100vh;
}

.hero-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 20% 10%, rgba(212, 165, 165, 0.18), transparent 25%),
    radial-gradient(circle at 80% 20%, rgba(163, 177, 138, 0.16), transparent 28%),
    radial-gradient(circle at 50% 100%, rgba(176, 137, 104, 0.10), transparent 32%);
  filter: blur(8px);
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  min-height: 82px;
  padding: 14px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  border-bottom: 1px solid rgba(74, 87, 89, 0.08);
  background: rgba(248, 245, 239, 0.86);
  backdrop-filter: blur(14px);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-logo {
  width: 52px;
  height: 52px;
  object-fit: contain;
  border-radius: 14px;
  display: block;
  box-shadow: 0 10px 26px rgba(176, 137, 104, 0.16);
  background: rgba(255, 255, 255, 0.45);
  padding: 4px;
}

.brand strong {
  display: block;
  font-size: 20px;
  letter-spacing: -0.04em;
  color: #4a5759;
}

.brand span {
  display: block;
  margin-top: 2px;
  color: #7a8574;
  font-size: 12px;
}

.lang-switcher,
.tabs,
.switcher,
.mode-row {
  display: flex;
  gap: 8px;
  padding: 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(74, 87, 89, 0.08);
  box-shadow: 0 6px 18px rgba(74, 87, 89, 0.05);
}

.lang-switcher button,
.tab-btn,
.switcher button,
.mode-row button {
  min-height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  color: #7a8574;
  cursor: pointer;
  background: transparent;
  font-weight: 700;
  transition: 0.2s ease;
}

.lang-switcher button.active,
.tab-btn.active,
.switcher button.active,
.mode-row button.active {
  color: #ffffff;
  background: linear-gradient(135deg, #a3b18a, #b7b7a4 55%, #d4a5a5);
  box-shadow: 0 10px 24px rgba(163, 177, 138, 0.28);
}

.tab-btn {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tab-btn strong {
  min-width: 22px;
  height: 22px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-size: 11px;
  color: white;
  background: rgba(255, 255, 255, 0.28);
}

.container {
  position: relative;
  z-index: 2;
  width: min(1240px, calc(100% - 32px));
  margin: 0 auto;
  padding: 34px 0 80px;
}

.page-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 20px;
}

.glass {
  border: 1px solid rgba(74, 87, 89, 0.08);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.62));
  backdrop-filter: blur(14px);
  box-shadow:
    0 20px 50px rgba(74, 87, 89, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.intro-card,
.panel,
.empty-card,
.editor-card,
.stat-card {
  border-radius: 28px;
}

.intro-card {
  padding: 42px;
  min-height: 360px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.eyebrow {
  margin: 0 0 10px;
  color: #b08968;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 11px;
  font-weight: 900;
}

h1,
h2 {
  margin: 0;
  letter-spacing: -0.055em;
  color: #4a5759;
}

h1 {
  max-width: 760px;
  font-size: clamp(34px, 5vw, 64px);
  line-height: 0.95;
}

h2 {
  font-size: 24px;
}

.intro-card p:not(.eyebrow) {
  max-width: 620px;
  margin: 20px 0 0;
  color: #5f6d6f;
  line-height: 1.8;
  font-size: 15px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.btn {
  min-height: 44px;
  padding: 0 18px;
  border-radius: 14px;
  cursor: pointer;
  color: white;
  font-weight: 800;
  transition:
    transform 0.2s ease,
    opacity 0.2s ease,
    box-shadow 0.2s ease;
}

.btn:hover:not(:disabled) {
  transform: translateY(-1px);
}

.btn:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.btn-primary {
  background: linear-gradient(135deg, #a3b18a, #b7b7a4 55%, #d4a5a5);
  box-shadow: 0 14px 30px rgba(163, 177, 138, 0.24);
}

.btn-secondary {
  color: #4a5759;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(74, 87, 89, 0.10);
}

.panel {
  padding: 26px;
}

.panel.full {
  grid-column: 1 / -1;
}

.panel-header,
.section-title,
.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.upload-box {
  margin-top: 24px;
  min-height: 230px;
  border: 1.5px dashed rgba(176, 137, 104, 0.22);
  border-radius: 24px;
  display: grid;
  place-items: center;
  text-align: center;
  gap: 8px;
  padding: 28px;
  cursor: pointer;
  transition: 0.2s ease;
  background: rgba(255, 255, 255, 0.38);
}

.upload-box:hover {
  border-color: #a3b18a;
  background: rgba(204, 213, 174, 0.18);
}

.upload-icon {
  width: 70px;
  height: 70px;
  display: grid;
  place-items: center;
  border-radius: 24px;
  font-size: 30px;
  background: linear-gradient(135deg, rgba(163, 177, 138, 0.22), rgba(212, 165, 165, 0.22));
  color: #6b7b5d;
}

.upload-box span,
.upload-box em,
.form-group small {
  color: #7b7b70;
  font-size: 13px;
}

.upload-box em {
  color: #6b7b5d;
  font-style: normal;
  font-weight: 600;
}

.form-group {
  display: grid;
  gap: 8px;
  margin-top: 18px;
}

.form-group label {
  color: #6b6b5d;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.form-group input,
.schedule-input {
  width: 100%;
  min-height: 46px;
  padding: 0 14px;
  color: #4a5759;
  border-radius: 14px;
  border: 1px solid rgba(74, 87, 89, 0.10);
  background: rgba(255, 255, 255, 0.78);
  outline: none;
}

.form-group input:focus,
.schedule-input:focus,
textarea:focus {
  border-color: rgba(163, 177, 138, 0.8);
  box-shadow: 0 0 0 4px rgba(163, 177, 138, 0.14);
}

.two-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.preview-box {
  margin: 20px 0 0;
  min-height: 260px;
  max-height: 420px;
  overflow: auto;
  white-space: pre-wrap;
  color: #4a5759;
  line-height: 1.8;
  padding: 22px;
  border-radius: 22px;
  border: 1px solid rgba(74, 87, 89, 0.08);
  background: rgba(255, 255, 255, 0.76);
}

.stack {
  display: grid;
  gap: 20px;
}

.section-title {
  margin-bottom: 4px;
}

.section-title h1 {
  font-size: clamp(30px, 4vw, 52px);
}

.empty-card {
  padding: 44px;
  text-align: center;
  display: grid;
  gap: 8px;
}

.empty-card span {
  color: #7a8574;
}

.editor-card {
  padding: 24px;
}

.editor-head strong {
  display: block;
  font-size: 18px;
  color: #4a5759;
}

.editor-head span {
  display: block;
  margin-top: 4px;
  color: #7a8574;
  font-size: 13px;
}

.success-badge {
  padding: 8px 12px;
  color: #6b7b5d;
  background: rgba(204, 213, 174, 0.36);
  border: 1px solid rgba(163, 177, 138, 0.28);
  border-radius: 999px;
  font-size: 12px;
}

textarea {
  width: 100%;
  min-height: 170px;
  margin-top: 18px;
  resize: vertical;
  padding: 18px;
  color: #4a5759;
  line-height: 1.7;
  border-radius: 22px;
  outline: none;
  border: 1px solid rgba(74, 87, 89, 0.08);
  background: rgba(255, 255, 255, 0.78);
}

.editor-meta {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  margin-top: 10px;
  color: #7a8574;
  font-size: 13px;
}

.editor-meta button,
.image-button {
  color: #b08968;
  cursor: pointer;
  background: transparent;
  font-weight: 800;
}

.ai-box {
  margin-top: 16px;
  padding: 18px;
  border-radius: 22px;
  color: #4a5759;
  border: 1px solid rgba(212, 165, 165, 0.24);
  background: rgba(212, 165, 165, 0.16);
}

.ai-box strong {
  display: block;
  color: #8f6c6c;
  margin-bottom: 8px;
}

.ai-box p {
  margin: 0;
  line-height: 1.7;
}

.platform-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.platform-row button {
  min-height: 42px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #4a5759;
  cursor: pointer;
  border-radius: 999px;
  border: 1px solid rgba(74, 87, 89, 0.08);
  background: rgba(255, 255, 255, 0.60);
}

.platform-row button.selected {
  color: #2f3a3b;
  border-color: rgba(176, 137, 104, 0.25);
  background: rgba(221, 190, 169, 0.34);
}

.platform-row i {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  color: white;
  font-style: normal;
  font-weight: 900;
  border-radius: 999px;
  background: var(--platform-color);
}

.post-tools {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}

.image-button {
  min-height: 44px;
  padding: 0 16px;
  border-radius: 14px;
  border: 1px solid rgba(176, 137, 104, 0.20);
  background: rgba(221, 190, 169, 0.20);
}

.image-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #4a5759;
  font-size: 13px;
}

.image-chip img {
  width: 42px;
  height: 42px;
  object-fit: cover;
  border-radius: 14px;
}

.schedule-input {
  width: 240px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.stat-card {
  padding: 22px;
}

.stat-card span {
  display: block;
  color: #8f6c6c;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.stat-card strong {
  display: block;
  margin-top: 12px;
  font-size: 34px;
  letter-spacing: -0.06em;
  color: #6b7b5d;
}

.stat-card small {
  display: block;
  color: #7a8574;
  margin-top: 6px;
}

.bar-list {
  display: grid;
  gap: 14px;
  margin-top: 20px;
}

.bar-item {
  display: grid;
  grid-template-columns: 120px 1fr 70px;
  gap: 12px;
  align-items: center;
}

.bar-item span {
  color: #4a5759;
  font-size: 13px;
}

.bar-item div {
  height: 12px;
  border-radius: 999px;
  overflow: hidden;
  background: rgba(176, 137, 104, 0.12);
}

.bar-item i {
  display: block;
  height: 100%;
  border-radius: 999px;
}

.bar-item strong {
  text-align: right;
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
  margin-top: 18px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th {
  text-align: left;
  color: #8f6c6c;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 14px;
  border-bottom: 1px solid rgba(74, 87, 89, 0.08);
}

td {
  color: #4a5759;
  padding: 16px 14px;
  border-bottom: 1px solid rgba(74, 87, 89, 0.06);
  font-size: 14px;
}

.platform-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 32px;
  padding: 0 12px;
  color: white;
  border-radius: 999px;
}

@media (max-width: 980px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .topbar-right {
    width: 100%;
    justify-content: flex-start;
  }

  .page-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .intro-card {
    padding: 28px;
  }

  .two-cols {
    grid-template-columns: 1fr;
  }

  .panel-header,
  .section-title,
  .editor-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .bar-item {
    grid-template-columns: 1fr;
  }

  .bar-item strong {
    text-align: left;
  }

  .schedule-input {
    width: 100%;
  }
}

@media (max-width: 560px) {
  .container {
    width: min(100% - 20px, 1240px);
    padding-top: 20px;
  }

  .brand span {
    display: none;
  }

  .lang-switcher,
  .tabs {
    width: 100%;
    overflow-x: auto;
    justify-content: flex-start;
  }

  .tab-btn {
    white-space: nowrap;
  }

  .intro-card,
  .panel,
  .editor-card,
  .empty-card,
  .stat-card {
    border-radius: 22px;
  }

  .intro-card,
  .panel,
  .editor-card {
    padding: 20px;
  }

  .post-tools {
    align-items: stretch;
    flex-direction: column;
  }

  .post-tools .btn,
  .image-button,
  .schedule-input {
    width: 100%;
  }
}

.platform-pill {
  background: color-mix(in srgb, var(--platform-color) 42%, #b08968);
  border: 1px solid color-mix(in srgb, var(--platform-color) 32%, rgba(74, 87, 89, 0.12));
}

